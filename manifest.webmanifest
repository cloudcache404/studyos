{
  "name": "StudyOS — Your personal student command center",
  "short_name": "StudyOS",
  "description": "An all-in-one dashboard for students: tasks, exams, focus timer, flashcards and progress — all local, no account needed.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0a0d16",
  "theme_color": "#0b0e17",
  "icons": [
    { "src": "assets/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "assets/icons/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any" }
  ]
}
